/* Procedure structure for procedure `role_permissions_assign` */

/*!50003 DROP PROCEDURE IF EXISTS  `role_permissions_assign` */;

DELIMITER $$

/*!50003 CREATE PROCEDURE `role_permissions_assign`(
    IN json_input JSON
)
    MODIFIES SQL DATA
    SQL SECURITY INVOKER
    COMMENT 'Assigns permissions to a role. Additive only. Success = no exception. Errors: 50011–50013'
BEGIN
    -- Variable declarations
    DECLARE v_role_id         INT UNSIGNED;
    DECLARE v_assigned_by     INT UNSIGNED;
    DECLARE v_new_count       INT UNSIGNED;

    -- Global exception handler
    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        RESIGNAL;
    END;

    -- Parse & validate input
    SET v_role_id     = JSON_VALUE(json_input, '$.role_id'     RETURNING UNSIGNED);
    SET v_assigned_by = JSON_VALUE(json_input, '$.assigned_by' RETURNING UNSIGNED);

    IF v_role_id IS NULL OR v_role_id = 0 THEN
        SIGNAL SQLSTATE '45000' SET 
            MYSQL_ERRNO = 50011,
            MESSAGE_TEXT = 'role_id missing or invalid';
    END IF;

    IF v_assigned_by IS NULL OR v_assigned_by = 0 THEN
        SIGNAL SQLSTATE '45000' SET 
            MYSQL_ERRNO = 50012,
            MESSAGE_TEXT = 'assigned_by missing or invalid';
    END IF;

    -- Strict privilege restriction: only users with 'role:manage_permissions' can execute
    IF NOT EXISTS (
        SELECT 1
        FROM users u
        INNER JOIN user_roles     ur  ON ur.user_id = u.user_id
        INNER JOIN role_permissions rp ON rp.role_id = ur.role_id
        INNER JOIN permissions    p   ON p.permission_id = rp.permission_id
        WHERE u.user_id     = v_assigned_by
          AND u.is_active   = 1
          AND (u.locked_until IS NULL OR u.locked_until < NOW())
          AND p.permission_name in ('role:manage', 'rbac:full_access')
    ) THEN
        SIGNAL SQLSTATE '45000' SET 
            MYSQL_ERRNO = 50013,
            MESSAGE_TEXT = 'insufficient privilege to manage role permissions';
    END IF;

    START TRANSACTION;

    -- Additive insert only (no replace/delete – revocation is separate operation)
    INSERT IGNORE INTO role_permissions (role_id, permission_id)
    SELECT
        v_role_id,
        jt.permission_id
    FROM JSON_TABLE(
        json_input,
        '$.permission_ids[*]' COLUMNS (
            permission_id INT PATH '$' ERROR ON ERROR
        )
    ) AS jt
    WHERE jt.permission_id > 0;

    -- Final state for audit
    SELECT COUNT(*) INTO v_new_count
    FROM role_permissions WHERE role_id = v_role_id;

    -- Audit trail
    INSERT INTO audit_logs (
        user_id, action, entity_type, entity_id, details, success
    ) VALUES (
        v_assigned_by,
        'role_permissions_assigned',
        'role',
        v_role_id,
        JSON_OBJECT(
            'target_role_id',       v_role_id,
            'permission_ids_input', JSON_EXTRACT(json_input, '$.permission_ids'),
            'new_permission_count', v_new_count,
            'invoker',              CURRENT_USER(),
            'timestamp_utc',        UTC_TIMESTAMP()
        ),
        1
    );

    COMMIT;
END */$$
DELIMITER ;

