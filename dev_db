    -- Variable declarations
    -- ────────────────────────────────────────────────────────────────
    DECLARE v_user_id         INT UNSIGNED;
    DECLARE v_assigned_by     INT UNSIGNED;
    DECLARE v_new_role_count  INT UNSIGNED;


    -- ────────────────────────────────────────────────────────────────
    -- Global exception handler (rollback + rethrow on any error)
    -- ────────────────────────────────────────────────────────────────
    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        RESIGNAL;
    END;


    -- ────────────────────────────────────────────────────────────────
    -- Parse scalar input values + basic validation
    -- ────────────────────────────────────────────────────────────────
    SET v_user_id     = JSON_VALUE(json_input, '$.user_id'     RETURNING UNSIGNED);
    SET v_assigned_by = JSON_VALUE(json_input, '$.assigned_by' RETURNING UNSIGNED);

    IF v_user_id IS NULL OR v_user_id = 0 THEN
        SIGNAL SQLSTATE '45000' SET 
            MYSQL_ERRNO = 50001,
            MESSAGE_TEXT = 'user_id missing or invalid';
    END IF;

    IF v_assigned_by IS NULL OR v_assigned_by = 0 THEN
        SIGNAL SQLSTATE '45000' SET 
            MYSQL_ERRNO = 50002,
            MESSAGE_TEXT = 'assigned_by missing or invalid';
    END IF;


    -- ────────────────────────────────────────────────────────────────
    -- Authorization check (RBAC-based)
    -- Caller must hold at least one of the listed manage permissions
    -- ────────────────────────────────────────────────────────────────
    IF NOT EXISTS (
        SELECT 1
        FROM users u
        INNER JOIN user_roles     ur  ON ur.user_id = u.user_id
        INNER JOIN role_permissions rp ON rp.role_id = ur.role_id
        INNER JOIN permissions    p   ON p.permission_id = rp.permission_id
        WHERE u.user_id     = v_assigned_by
          AND u.is_active   = 1
          AND (u.locked_until IS NULL OR u.locked_until < NOW())
          AND p.permission_name IN ('user:manage', 'rbac:full_access')
    ) THEN
        SIGNAL SQLSTATE '45000' SET 
            MYSQL_ERRNO = 50003,
            MESSAGE_TEXT = 'insufficient privilege to assign roles';
    END IF;


    -- ────────────────────────────────────────────────────────────────
    -- Begin transaction — all mutations are now atomic
    -- ────────────────────────────────────────────────────────────────
    START TRANSACTION;


    -- ────────────────────────────────────────────────────────────────
    -- Replace strategy: revoke all current roles of the target user
    -- ────────────────────────────────────────────────────────────────
    DELETE FROM user_roles WHERE user_id = v_user_id;


    -- ────────────────────────────────────────────────────────────────
    -- Assign requested roles (set-based)
    --   • JSON_TABLE converts array to rows
    --   • INT PATH + ERROR ON ERROR → strict type enforcement
    --   • IGNORE → handles duplicates gracefully (PK constraint)
    --   • WHERE jt.role_id > 0 → business-level filter (exclude ≤0)
    -- ────────────────────────────────────────────────────────────────
    INSERT IGNORE INTO user_roles (user_id, role_id)
    SELECT
        v_user_id,
        jt.role_id
    FROM JSON_TABLE(
        json_input,
        '$.role_ids[*]' COLUMNS (
            role_id INT PATH '$' ERROR ON ERROR
        )
    ) AS jt
    WHERE jt.role_id > 0;


    -- ────────────────────────────────────────────────────────────────
    -- Read final role count for audit trail
    -- ────────────────────────────────────────────────────────────────
    SELECT COUNT(*) INTO v_new_role_count
    FROM user_roles WHERE user_id = v_user_id;


    -- ────────────────────────────────────────────────────────────────
    -- Audit logging (immutable record of who changed what)
    -- ────────────────────────────────────────────────────────────────
    INSERT INTO audit_logs (
        user_id, action, entity_type, entity_id, details, success
    ) VALUES (
        v_assigned_by,
        'user_roles_assigned',
        'user',
        v_user_id,
        JSON_OBJECT(
            'target_user_id',   v_user_id,
            'role_ids_input',   JSON_EXTRACT(json_input, '$.role_ids'),
            'new_role_count',   v_new_role_count,
            'invoker',          CURRENT_USER(),
            'timestamp_utc',    UTC_TIMESTAMP()
        ),
        1
    );


    -- ────────────────────────────────────────────────────────────────
    -- Commit — transaction completes only if no exception occurred
    -- ────────────────────────────────────────────────────────────────
    COMMIT;

END */$$
